{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "build-module/**"]
    },
    "clean": {
      "cache": false
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["build-types/**", "tsconfig.tsbuildinfo"]
    },
    "watch:types": {
      "dependsOn": ["^watch:types"],
      "outputs": ["build-types/**", "tsconfig.tsbuildinfo"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
