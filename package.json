{
	"name": "lapilli-ui",
	"version": "1.0.0-beta.6",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "pnpm run build:types && pnpm run build:packages",
		"build:types": "turbo run build:types",
		"build:packages": "node ./bin/packages/build.js",
		"watch": "concurrently \"pnpm run watch:types\" \"pnpm run watch:packages\"",
		"watch:types": "turbo run watch:types",
		"watch:packages": "node ./bin/packages/watch.js",
		"clean": "turbo run clean",
		"release:publish": "lerna publish from-package --dist-tag latest --no-private",
		"release:dry-run": "lerna publish from-package --dist-tag latest --no-private --registry=\"http://localhost:4873/\""
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@babel/plugin-transform-react-jsx": "^7.25.0",
		"@babel/plugin-transform-runtime": "^7.26.0",
		"@babel/preset-env": "^7.26.0",
		"@babel/preset-react": "^7.26.0",
		"@babel/preset-typescript": "^7.26.0",
		"@babel/runtime": "^7.26.0",
		"@emotion/babel-plugin": "^11.13.0",
		"@types/lodash": "^4.17.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"babel-plugin-optimize-clsx": "^2.6.2",
		"chalk": "4.1.2",
		"concurrently": "^9.0.0",
		"fast-glob": "^3.3.0",
		"lerna": "^8.1.0",
		"lodash": "^4.17.21",
		"make-dir": "^3.1.0",
		"node-watch": "^0.7.3",
		"prettier": "^3.4.0",
		"progress": "^2.0.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rimraf": "^6.0.0",
		"turbo": "^2.10.0",
		"typescript": "^5.7.0",
		"worker-farm": "^1.7.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "^19.0.0",
			"@types/react-dom": "^19.0.0"
		}
	},
	"packageManager": "pnpm@9.15.0"
}
