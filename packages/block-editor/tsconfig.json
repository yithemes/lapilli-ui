{
	"extends": "@lapilli-ui/tsconfig/react-library.json",
	"include": [
		"src/*",
		"src/**/*"
	],
	"exclude": [
		"src/**/stories/**",
		"build",
		"build-module",
		"build-types"
	],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "build-module",
		"declarationDir": "build-types",
	},
	"references": [
		{ "path": "../styles" },
		{ "path": "../date" }
	]
}
